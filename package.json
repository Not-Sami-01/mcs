{
  "name": "mcs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "payload migrate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,json,scss,css}\" \"*.{mjs,json,yaml,yml}\" \"tests/**/*\" \".github/**/*\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/seed/cli.ts",
    "seed:admin": "payload run src/seed/admin-cli.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/storage-s3": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "@purposeinplay/payload-totp": "0.5.1",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "otpauth": "9.6.0",
    "postcss": "^8.5.6",
    "prettier": "3.10.1",
    "sass": "^1.93.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
