# Copy this file to `.env` (or `.env.local`) and fill in the blanks. Never commit a real .env file.
# Full explanation of each variable: docs/OPERATIONS.md section 2. Storage ones: docs/STORAGE.md.
#
# Syntax: KEY=value, no spaces around '='. Lines starting with '#' are comments.
# ⚠ A line like `KEY=` (empty) sets the variable to an EMPTY string and overrides a value
#   coming from another env file — delete lines you are not using, never leave them empty.

# ───────────────────────────────── Core (required) ─────────────────────────────────
# Environment selector: development | staging | production.
# Controls indexing (noindex outside production) and whether emails really send.
# Must be set at BOTH build time and run time (docs/OPERATIONS.md section 1).
SITE_ENV=development

# Public base URL of the site, no trailing slash. Used for canonical URLs, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev uses the docker-compose credentials below. On Vercel use the POOLER connection string.
DATABASE_URL=postgresql://mcs:mcs_dev_password@127.0.0.1:5432/mcs

# Payload signing secret for sessions/JWTs. Generate: openssl rand -hex 32
# The app refuses to start without it. Different value per environment.
PAYLOAD_SECRET=

# Bearer secret that protects the Payload jobs endpoint (used by Vercel Cron for scheduled publish).
# Generate: openssl rand -hex 32 — only needed once scheduled publish (CP-4.x) ships.
CRON_SECRET=

# ───────────────────────────────── Storage: Filebase (docs/STORAGE.md) ─────────────
# S3 endpoint and region. These two values are fixed for Filebase (verified 2026-11-19).
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto

# API keys from the Filebase console (Account → API Keys). Server-side only — never expose to the browser.
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=

# The single Filebase bucket that holds all uploads (site media and customer photos).
# NOTE: IPFS-backed storage means anything here can be fetched by its CID — customer photos
# must be encrypted before upload (UPLOAD_ENCRYPTION_KEY) regardless of bucket privacy.
FILEBASE_BUCKET=vaultifier

# Optional public base URL for building direct media links (CDN/gateway/custom domain).
# Leave empty to serve media through Payload's own media route (safe default).
FILEBASE_PUBLIC_BASE_URL=

# 32-byte key that encrypts customer photos before upload (openssl rand -hex 32).
# Encrypting before upload is what actually protects them if a CID leaks (docs/STORAGE.md section 5).
UPLOAD_ENCRYPTION_KEY=
# Name/ID of the active encryption key (e.g. v1) so old photos stay readable after key rotation.
UPLOAD_ENCRYPTION_KEY_ID=

# ───────────────────────────────── Security (docs/SECURITY.md) ─────────────────────
# Encrypts staff 2FA/TOTP secrets at rest in the database (openssl rand -hex 32). Used from CP-2.2.
TOTP_ENCRYPTION_KEY=

# Salt for hashing visitor IPs in abuse/rate-limit logs (openssl rand -hex 16).
# Raw IPs are never written to logs or analytics.
IP_HASH_SALT=

# Cloudflare Turnstile spam protection on public forms (docs/SECURITY.md C4).
# Site key is public by design; secret stays server-side. Get both from dash.cloudflare.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────────────────────────── Email (docs/DECISIONS.md Q10) ───────────────────
# Provider: resend | postmark | ses. `console` logs emails to the terminal (development only).
EMAIL_PROVIDER=console

# Provider API key (server-side only). Not needed while the provider is `console`.
EMAIL_API_KEY=

# From address on the authenticated sending domain, e.g. no-reply@example.com
EMAIL_FROM=

# Fallback recipients for new-lead alerts, comma separated. The live list is editable in site-settings.
LEADS_ALERT_TO=

# ───────────────────────────────── Analytics and live chat ─────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Public by design. Empty = analytics disabled.
NEXT_PUBLIC_GA4_ID=

# Live chat provider: tawk | crisp | chatwoot (docs/DECISIONS.md Q11). Empty = chat hidden.
NEXT_PUBLIC_CHAT_PROVIDER=
# The provider-side site/account ID that goes with the provider above.
NEXT_PUBLIC_CHAT_ID=

# ───────────────────────────────── Monitoring (optional) ───────────────────────────
# Sentry DSN (or future provider equivalent). Empty = error monitoring disabled.
SENTRY_DSN=
